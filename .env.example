# Copy to .env for local development. Placeholders only — never commit real values.
# .env is git-ignored and docker-ignored.

# JDBC form; keep credentials in their own variables, not in the URL.
DB_URL=jdbc:postgresql://localhost:5432/ajo
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Base64-encoded signing key of at least 256 bits. Generate one with:
#   openssl rand -base64 64
# Required: the app refuses to start without it.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-64

# Comma-separated browser origins allowed to call the API (exact scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:3000
